# 服务器监听 IP（默认 0.0.0.0 监听所有网卡）
HOST=0.0.0.0

# 服务器端口
PORT=3001

# development 或 production
NODE_ENV=development

# MySQL：仅保存用户、用户行为、询盘和沟通数据
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=curva_denim_b2b
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=10
DB_AUTO_SCHEMA=false
EVENT_HASH_SALT=

# 生产环境必填：至少32字符的唯一强随机值
JWT_SECRET=

# Lark 自定义机器人：推送机器人聊天、询价以及聊天中的联系人信息
LARK_WEBHOOK_URL=
# 如果机器人开启了“签名校验”，在此填写签名密钥；否则留空
LARK_WEBHOOK_SECRET=
